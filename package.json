{
  "name": "searchfast-antigravity",
  "displayName": "SearchFast Antigravity",
  "description": "Ultra-fast file and content search powered by ripgrep",
  "version": "1.0.0",
  "publisher": "searchfast",
  "repository": {
    "type": "git",
    "url": "https://github.com/searchfast/searchfast-antigravity"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "keywords": ["search", "ripgrep", "rg", "fast", "find", "grep"],
  "activationEvents": [
    "onView:searchfast.searchView",
    "onCommand:searchfast.searchWordUnderCursor",
    "onCommand:searchfast.searchSelectedText",
    "onCommand:searchfast.checkRipgrep",
    "onCommand:searchfast.focusSearchInput",
    "onCommand:searchfast.changeShortcuts"
  ],
  "main": "./out/extension.js",
  "icon": "resources/icon.png",
  "contributes": {
    "commands": [
      {
        "command": "searchfast.searchWordUnderCursor",
        "title": "SearchFast: Search Word Under Cursor"
      },
      {
        "command": "searchfast.searchSelectedText",
        "title": "SearchFast: Search Selected Text"
      },
      {
        "command": "searchfast.checkRipgrep",
        "title": "SearchFast: Check Ripgrep Installation"
      },
      {
        "command": "searchfast.focusSearchInput",
        "title": "SearchFast: Focus Search Box"
      },
      {
        "command": "searchfast.changeShortcuts",
        "title": "SearchFast: Change Keyboard Shortcuts"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "searchfast",
          "title": "SearchFast Antigravity",
          "icon": "$(search)"
        }
      ]
    },
    "views": {
      "searchfast": [
        {
          "type": "webview",
          "id": "searchfast.searchView",
          "name": "Search"
        }
      ]
    },
    "keybindings": [
      {
        "command": "searchfast.searchWordUnderCursor",
        "key": "ctrl+alt+f",
        "mac": "cmd+alt+f",
        "when": "editorTextFocus"
      },
      {
        "command": "searchfast.searchSelectedText",
        "key": "ctrl+alt+d",
        "mac": "cmd+alt+d",
        "when": "editorTextFocus && editorHasSelection"
      },
      {
        "command": "searchfast.focusSearchInput",
        "key": "ctrl+alt+s",
        "mac": "cmd+alt+s"
      }
    ],
    "configuration": {
      "title": "SearchFast Antigravity",
      "properties": {
        "searchfast.ripgrepPath": {
          "type": "string",
          "default": "",
          "description": "Path to ripgrep binary. Leave empty to auto-detect."
        },
        "searchfast.maxResults": {
          "type": "number",
          "default": 5000,
          "description": "Maximum number of search results to display."
        },
        "searchfast.contextLines": {
          "type": "number",
          "default": 2,
          "description": "Number of context lines around each match."
        },
        "searchfast.caseSensitive": {
          "type": "boolean",
          "default": false,
          "description": "Default case sensitivity for searches."
        },
        "searchfast.wholeWord": {
          "type": "boolean",
          "default": false,
          "description": "Default whole word matching."
        },
        "searchfast.useRegex": {
          "type": "boolean",
          "default": false,
          "description": "Default regex mode."
        },
        "searchfast.followSymlinks": {
          "type": "boolean",
          "default": false,
          "description": "Follow symbolic links during search."
        },
        "searchfast.hiddenFiles": {
          "type": "boolean",
          "default": false,
          "description": "Include hidden files and directories."
        },
        "searchfast.respectGitignore": {
          "type": "boolean",
          "default": true,
          "description": "Respect .gitignore rules."
        },
        "searchfast.defaultExcludes": {
          "type": "array",
          "items": { "type": "string" },
          "default": ["node_modules", ".git", "dist", "build", ".next", "__pycache__", ".venv", "vendor"],
          "description": "Default directories/patterns to exclude from search."
        },
        "searchfast.enableHighlight": {
          "type": "boolean",
          "default": true,
          "description": "Highlight search matches in results."
        },
        "searchfast.liveSearchDelay": {
          "type": "number",
          "default": 300,
          "minimum": 0,
          "maximum": 2000,
          "description": "How long to wait (in milliseconds) after you stop typing before SearchFast searches automatically."
        },
        "searchfast.minQueryLength": {
          "type": "number",
          "default": 2,
          "minimum": 1,
          "maximum": 10,
          "description": "Minimum number of characters required before SearchFast searches automatically as you type. Press Enter to search regardless of this setting."
        },
        "searchfast.confirmBeforeReplace": {
          "type": "boolean",
          "default": true,
          "description": "Ask for confirmation before replacing text in your files. Turning this off is not recommended."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.3",
    "@vscode/vsce": "^2.22.0"
  }
}
